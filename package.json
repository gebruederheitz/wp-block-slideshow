{
    "name": "@gebruederheitz/wp-block-slideshow",
    "version": "3.0.1",
    "description": "A Gutenberg block creating a slideshow",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "lint": "npm-run-all --parallel lint:scripts lint:styles",
        "lint:scripts": "eslint frontend/ editor/",
        "lint:styles": "stylelint scss/",
        "build": "npm-run-all --parallel build:rollup build:styles",
        "build:rollup": "rollup -c ./.rollup.config.js",
        "build:styles": "gulp",
        "release": "release-it --only-version",
        "watch": "npm-run-all --parallel watch:rollup watch:styles",
        "watch:rollup": "rollup -c ./.rollup.config.js --watch",
        "watch:styles": "gulp watch"
    },
    "engines": {
        "node": ">=22"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gebruederheitz/wp-block-slideshow.git"
    },
    "keywords": [
        "Wordpress",
        "Gutenberg",
        "slideshow"
    ],
    "author": "Andreas Maros <andreas.maros@gebruederheitz.de>",
    "license": "GPL-3.0-only",
    "bugs": {
        "url": "https://github.com/gebruederheitz/wp-block-video-overlay/issues"
    },
    "homepage": "https://github.com/gebruederheitz/wp-block-video-overlay#readme",
    "dependencies": {
        "@babel/runtime": "^7.29.7",
        "@fortawesome/free-solid-svg-icons": "^5.15.4",
        "@gebruederheitz/wp-editor-components": "^1.2.0",
        "@gebruederheitz/wp-frontend-utils": "^1.1.1",
        "@glidejs/glide": "^3.7.1",
        "@splidejs/splide": "^2.4.21",
        "classnames": "^2.5.1",
        "core-js": "^3.49.0",
        "lodash-es": "^4.18.1",
        "mitt": "^3.0.1",
        "swiper": "^14.0.5"
    },
    "devDependencies": {
        "@babel/plugin-transform-react-jsx": "^7.29.7",
        "@babel/plugin-transform-runtime": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@rollup/plugin-babel": "^7.1.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "autoprefixer": "^10.5.3",
        "cssnano": "^8.0.2",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "gulp": "^5.0.1",
        "gulp-dart-sass": "^1.1.0",
        "gulp-postcss": "^10.0.0",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.19",
        "prettier": "^3.9.5",
        "release-it": "^20.2.1",
        "rollup": "^4.62.2",
        "sass": "^1.101.0",
        "stylelint": "^17.14.0",
        "stylelint-config-recommended-scss": "^17.0.1",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-scss": "^7.2.0"
    },
    "allowScripts": {
        "@fortawesome/free-solid-svg-icons@5.15.4": true,
        "core-js@3.49.0": true,
        "@parcel/watcher@2.5.6": true,
        "@fortawesome/fontawesome-common-types@0.2.36": true,
        "@fortawesome/fontawesome-svg-core@1.2.36": true
    }
}
